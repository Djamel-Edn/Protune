# ---------------------------------------------------------------
# Protune — copy to .env and fill in. NEVER commit .env.
#
# Leave a variable out entirely rather than setting it to an empty value:
# blank values are ignored and the defaults apply, but keeping them out
# keeps the deployed configuration readable.
# ---------------------------------------------------------------

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-flash-lite-latest

# --- Supabase (https://supabase.com/dashboard) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: backend only, never exposed to the browser
SUPABASE_SERVICE_KEY=

# --- Public demo rate limiting (https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Per visitor, then for every visitor combined. The Gemini free tier allows
# 1000 requests a day and one generation costs three, so the global cap sits
# below the ~330 that implies. Leave both unset to disable rate limiting.
DEMO_DAILY_LIMIT=3
DEMO_GLOBAL_DAILY_LIMIT=250

# --- Backend ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Salt used to hash IP addresses (abuse prevention without storing raw IPs)
IP_HASH_SALT=change-me

# --- Frontend (shipped to the browser: nothing secret here) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
