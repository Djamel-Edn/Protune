# ---------------------------------------------------------------
# Protune — copier en .env et remplir. NE JAMAIS committer .env.
# ---------------------------------------------------------------

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-flash-lite-latest

# --- Supabase (https://supabase.com/dashboard) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role : backend uniquement, jamais exposée au navigateur
SUPABASE_SERVICE_KEY=

# --- Rate limiting de la démo publique (https://upstash.com) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DEMO_DAILY_LIMIT=3

# --- Backend ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
# Sel utilisé pour hacher les IP (anti-abus sans stocker d'IP en clair)
IP_HASH_SALT=change-me

# --- Frontend (exposé au navigateur : rien de secret ici) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
